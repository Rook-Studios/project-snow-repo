; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="project-snow"
run/main_scene="res://scenes/test_scene.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/test-assets/icon.svg"

[autoload]

QuestManager="*res://scripts/QuestManager.gd"
InputHints="*res://scripts/InputHints.gd"
EventBus="*res://scripts/EventBus.gd"
Requests="*res://scripts/Requests.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4

[file_customization]

folder_colors={
"res://assets/": "teal",
"res://resources/": "purple",
"res://scenes/": "red",
"res://scripts/": "orange"
}

[global_group]

DialogueUI=""
Player=""

