choice_labels = Array[String](["Red.", "Red!", "Red..?"])
followup_choice0 = Array[String](["but of course, it is always red. Redder than ever, I hope."])
followup_choice1 = Array[String](["Ah, a true Redhead like myself! I am glad you enjoyed its hue."])
